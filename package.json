{
  "name": "landscape",
  "version": "0.2.0",
  "description": "Map the labs you are considering, then find where you actually fit. Runs locally against Ollama.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/copy-worker.mjs && esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js --minify",
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "fast": "node dist/server/index.js --fast",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/core/*.test.js\"",
    "bench": "node dist/server/bench.js"
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
